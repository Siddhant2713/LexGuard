# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# ─── Auth ────────────────────────────────────────────────────────────────────
# Required, 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# For a frontend on a different site in production: COOKIE_SAMESITE=none (needs HTTPS + NODE_ENV=production)
# COOKIE_SAMESITE=lax
# Number of reverse proxies in front of the API (so rate limits see real client IPs)
# TRUST_PROXY=1

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/lexguard
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lexguard
MONGODB_URI=mongodb://127.0.0.1:27017/lexguard

# ─── Groq ────────────────────────────────────────────────────────────────────
# Free key: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_CHAT_MODEL=openai/gpt-oss-20b
# Pass 3 (overall summary). Defaults to the chat model so it has its own token budget.
# GROQ_AGGREGATION_MODEL=openai/gpt-oss-20b

PASS2_CONCURRENCY=3

# Rate-limit budget per model (Groq free tier = 8000 tokens/min). Raise all three on a paid tier.
# GROQ_TPM=8000
# MAX_CONTEXT_CHARS=16000
# GROQ_REASONING_EFFORT=low

# ─── Razorpay (live) ─────────────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys. The secret never leaves the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional until the API has a public HTTPS URL. You make this secret up yourself (Razorpay
# doesn't issue it): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# then Dashboard → Webhooks → Add: URL https://<api-host>/billing/webhook, the same secret, events
# payment.authorized, payment.captured, order.paid, refund.processed.

